@{
    ViewData["Title"] = "Manage Overdue Books";
}

<div class="lms-page-header">
    <div>
        <h4><i class="bi bi-alarm-fill"></i> Manage Overdue Books</h4>
        <div class="header-subtitle">Books not returned past their due date.</div>
    </div>
</div>

<div class="row g-3">

    <!-- ══ Left: Filter Panel ════════════════════════════════════ -->
    <div class="col-lg-3">
        <div class="lms-card p-3">
            <div class="fw-bold mb-3" style="color:var(--lms-primary-dark);font-size:.82rem;text-transform:uppercase;letter-spacing:.05em">
                <i class="bi bi-funnel me-2"></i>Filters
            </div>

            <div class="mb-3">
                <label class="form-label">Days Passed <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm">
                    <input type="number" class="form-control" id="fDays" value="1" min="0" />
                    <span class="input-group-text">days</span>
                </div>
                <div class="text-muted-sm mt-1">Show records overdue by at least this many days.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Member Type</label>
                <div class="d-flex flex-column gap-1">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="memberType"
                               id="rbAll" value="All" checked />
                        <label class="form-check-label form-label mb-0" for="rbAll">All</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="memberType"
                               id="rbEmployees" value="Employees" />
                        <label class="form-check-label form-label mb-0" for="rbEmployees">Employees</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="memberType"
                               id="rbStudents" value="Students" />
                        <label class="form-check-label form-label mb-0" for="rbStudents">Students</label>
                    </div>
                </div>
            </div>

            <button class="btn btn-danger btn-sm w-100" id="btnFilter">
                <i class="bi bi-funnel-fill me-1"></i> Filter
            </button>

            <!-- Summary Card -->
            <div class="mt-3 p-3 rounded" style="background:#fef2f2;border:1px solid #fca5a5">
                <div class="text-danger fw-bold mb-1" style="font-size:.82rem">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Total Records
                </div>
                <div class="fs-4 fw-bold text-danger" id="totalRecords">0</div>
            </div>
        </div>
    </div>

    <!-- ══ Right: Results Grid ════════════════════════════════════ -->
    <div class="col-lg-9">
        <div class="lms-grid-wrapper">
            <div class="lms-grid-scroll">
                <table class="lms-table">
                    <thead>
                        <tr>
                            <th style="width:8%">Issue #</th>
                            <th style="width:9%;text-align:center">Days Passed</th>
                            <th style="width:10%">Member Type</th>
                            <th style="width:11%">Issue Date</th>
                            <th style="width:11%">Due Date</th>
                            <th>Member Name</th>
                            <th style="width:14%">Registration #</th>
                            <th>Book Title</th>
                        </tr>
                    </thead>
                    <tbody id="gridBody">
                        <tr><td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-funnel me-2"></i>
                            Set Days Passed and click <strong>Filter</strong>.</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="lms-action-bar">
                <span class="text-muted-sm" id="resultCount"></span>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
    function esc(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function fmtDate(d) {
        if (!d) return '';
        var dt = new Date(d);
        return dt.getDate().toString().padStart(2,'0') + '/' +
               (dt.getMonth()+1).toString().padStart(2,'0') + '/' + dt.getFullYear();
    }

    function doFilter() {
        var days = parseInt($('#fDays').val()) || 0;
        if (days < 0) { showToast('Days Passed must be 0 or more.', 'info'); return; }

        var payload = {
            daysPassed: days,
            memberType: $('input[name="memberType"]:checked').val()
        };

        $('#gridBody').html('<tr><td colspan="8" class="text-center py-3">' +
            '<div class="spinner-border spinner-border-sm text-danger me-2"></div>Loading...</td></tr>');

        $.ajax({
            url: '/OverdueBooks/Search', type: 'POST', contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function(res) {
                $('#totalRecords').text(res.length);
                $('#resultCount').text(res.length + ' overdue record(s)');

                if (!res.length) {
                    $('#gridBody').html('<tr><td colspan="8" class="text-center py-4 text-muted">' +
                        '<i class="bi bi-check-circle-fill text-success me-2"></i>' +
                        'No overdue books found for the given filter.</td></tr>');
                    return;
                }

                var html = res.map(function(r) {
                    var daysBadge = '<span class="lms-badge lms-badge-inactive">' +
                        r.daysOverdue + ' days</span>';
                    var typeBadge = '<span class="lms-badge ' +
                        (r.memberType === 'Student' ? 'lms-badge-info' : 'lms-badge-active') +
                        '">' + r.memberType + '</span>';

                    return '<tr>' +
                        '<td class="text-muted-sm fw-semibold">' + esc(r.issueNo) + '</td>' +
                        '<td class="text-center">' + daysBadge + '</td>' +
                        '<td>' + typeBadge + '</td>' +
                        '<td class="text-muted-sm">' + fmtDate(r.issueDate) + '</td>' +
                        '<td class="text-danger fw-bold">' + fmtDate(r.dueDate) + '</td>' +
                        '<td><strong>' + esc(r.memberName) + '</strong></td>' +
                        '<td class="text-muted-sm">' + esc(r.registrationNo||'') + '</td>' +
                        '<td class="text-muted-sm">' + esc(r.bookTitle) + '</td>' +
                        '</tr>';
                }).join('');

                $('#gridBody').html(html);
            }
        });
    }

    $('#btnFilter').click(doFilter);
    $('#fDays').on('keypress', function(e) { if (e.which === 13) doFilter(); });

    // Auto-run on page load with default 1 day
    doFilter();
</script>
}
