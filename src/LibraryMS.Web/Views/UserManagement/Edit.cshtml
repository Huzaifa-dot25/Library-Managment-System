@model LibraryMS.Application.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="lms-page-header">
    <div>
        <h4><i class="bi bi-pencil-square"></i> Edit User</h4>
        <div class="header-subtitle">Update account details and role assignment.</div>
    </div>
    <a asp-action="Index" class="btn-lms-secondary">
        <i class="bi bi-arrow-left"></i> Back to Users
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible d-flex gap-2 mb-3">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div>
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="lms-card p-4">

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="FullName" class="form-control" placeholder="Full name..." />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Role" class="form-label">Role</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-shield"></i></span>
                        <select asp-for="Role" class="form-select">
                            <option value="Librarian">Librarian — day-to-day operations</option>
                            <option value="Admin">Admin — full system access</option>
                        </select>
                    </div>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                    <div class="text-muted-sm mt-1">
                        <i class="bi bi-info-circle me-1"></i>
                        To change the password, use the <strong>Reset Password</strong> button on the users list.
                    </div>
                </div>

                <div class="lms-action-bar" style="border-radius:var(--radius-sm)">
                    <button type="submit" class="btn-lms-primary">
                        <i class="bi bi-save-fill"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn-lms-secondary">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>
