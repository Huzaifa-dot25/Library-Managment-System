@model LibraryMS.Application.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="lms-page-header">
    <div>
        <h4><i class="bi bi-key-fill"></i> Reset Password</h4>
        <div class="header-subtitle">Set a new password for <strong>@Model.Email</strong></div>
    </div>
    <a asp-action="Index" class="btn-lms-secondary">
        <i class="bi bi-arrow-left"></i> Back to Users
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible d-flex gap-2 mb-3">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div>
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-5">

        <!-- User info card -->
        <div class="lms-card p-3 mb-3 d-flex align-items-center gap-3">
            <div style="width:44px;height:44px;background:#eff6ff;border-radius:10px;
                        display:flex;align-items:center;justify-content:center;
                        font-size:1.3rem;color:var(--lms-primary)">
                <i class="bi bi-person-circle"></i>
            </div>
            <div>
                <div class="fw-bold">@Model.Email</div>
                <div class="text-muted-sm">Resetting password for this account</div>
            </div>
        </div>

        <div class="lms-card p-4">
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="NewPassword" type="password" class="form-control"
                               placeholder="New password (min 6 chars)" id="pwdNew" />
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="togglePwd('pwdNew', this)" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <!-- Password strength indicator -->
                <div class="mb-3">
                    <div class="d-flex gap-1 mb-1" id="strengthBars">
                        <div class="flex-grow-1 rounded" id="sb1"
                             style="height:4px;background:#e2e8f0"></div>
                        <div class="flex-grow-1 rounded" id="sb2"
                             style="height:4px;background:#e2e8f0"></div>
                        <div class="flex-grow-1 rounded" id="sb3"
                             style="height:4px;background:#e2e8f0"></div>
                        <div class="flex-grow-1 rounded" id="sb4"
                             style="height:4px;background:#e2e8f0"></div>
                    </div>
                    <small class="text-muted-sm" id="strengthLabel"></small>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control"
                               placeholder="Re-enter new password" id="pwdConfirm" />
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="togglePwd('pwdConfirm', this)" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="lms-action-bar" style="border-radius:var(--radius-sm)">
                    <button type="submit" class="btn-lms-primary">
                        <i class="bi bi-key-fill"></i> Reset Password
                    </button>
                    <a asp-action="Index" class="btn-lms-secondary">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function togglePwd(inputId, btn) {
        var inp  = document.getElementById(inputId);
        var icon = btn.querySelector('i');
        if (inp.type === 'password') {
            inp.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            inp.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }

    // Password strength meter
    document.getElementById('pwdNew').addEventListener('input', function () {
        var pwd = this.value;
        var score = 0;
        if (pwd.length >= 6)  score++;
        if (pwd.length >= 10) score++;
        if (/[A-Z]/.test(pwd) && /[a-z]/.test(pwd)) score++;
        if (/[0-9]/.test(pwd) && /[^A-Za-z0-9]/.test(pwd)) score++;

        var colors  = ['#ef4444', '#f59e0b', '#3b82f6', '#10b981'];
        var labels  = ['Weak', 'Fair', 'Good', 'Strong'];
        var bars    = ['sb1','sb2','sb3','sb4'];

        bars.forEach(function(id, idx) {
            document.getElementById(id).style.background =
                idx < score ? colors[score - 1] : '#e2e8f0';
        });

        document.getElementById('strengthLabel').textContent =
            pwd.length === 0 ? '' : labels[score - 1] || 'Weak';
    });
</script>
}
