@{ ViewData["Title"] = "Manage Class Levels"; }

<div class="lms-page-header">
    <div>
        <h4><i class="bi bi-mortarboard"></i> Manage Class Levels</h4>
        <div class="header-subtitle">Playgroup, FS1, FS2, Year 1–6, Pre IGCSE, IGCSE, AS/A Level etc.</div>
    </div>
    <button class="btn-lms-outline" id="btnAddRow"><i class="bi bi-plus-lg"></i> Add Row</button>
</div>

<div class="lms-grid-wrapper">
    <div class="lms-grid-scroll">
        <table class="lms-table">
            <thead><tr>
                <th style="width:60%">Class Name</th>
                <th style="width:30%">Sort Order</th>
                <th style="width:5%;text-align:center">Delete</th>
            </tr></thead>
            <tbody id="gridBody"><tr><td colspan="3" class="text-center py-4 text-muted"><i class="bi bi-hourglass-split me-2"></i>Loading...</td></tr></tbody>
        </table>
    </div>
    <div class="lms-action-bar">
        <button class="btn-lms-success" id="btnSaveAll"><i class="bi bi-save2"></i> Save All</button>
        <button class="btn-lms-secondary" onclick="window.location='/'"><i class="bi bi-x-lg"></i> Close</button>
    </div>
</div>

@section Scripts {<script>
function esc(s){return(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function renderRow(c){
    return '<tr data-id="'+c.classLevelId+'" data-dirty="false">'+
    '<td><input class="grid-input col-name" value="'+esc(c.name)+'" placeholder="Class name..." /></td>'+
    '<td><input type="number" class="grid-input col-sort" value="'+c.sortOrder+'" min="0" style="width:80px" /></td>'+
    '<td class="text-center"><button class="btn-grid-delete" data-id="'+c.classLevelId+'"><i class="bi bi-trash3"></i></button></td></tr>';}
function blankRow(){return renderRow({classLevelId:0,name:'',sortOrder:0});}
function loadGrid(){$.get('/Lookup/GetClassLevels',function(d){$('#gridBody').html(d.map(renderRow).join('')+blankRow());bindEvents();});}
function bindEvents(){
    $('#gridBody').off('input').on('input','input',function(){
        var $r=$(this).closest('tr').attr('data-dirty','true').addClass('row-dirty');
        if($r.is(':last-child')&&$r.attr('data-id')==='0'){$('#gridBody').append(blankRow());bindEvents();}
    });
    $('#gridBody').off('click','.btn-grid-delete').on('click','.btn-grid-delete',function(){
        var id=parseInt($(this).data('id'));var $r=$(this).closest('tr');
        if(id===0){$r.remove();return;}if(!confirmDelete('Delete class level?'))return;
        $.post('/Lookup/DeleteClassLevel',JSON.stringify(id),function(r){if(r.success){$r.fadeOut(200,function(){$(this).remove();});showToast('Deleted.');}else showToast(r.message,'error');},'json');
    });}
$('#btnSaveAll').click(async function(){
    var rows=$('#gridBody tr[data-dirty="true"]');
    if(!rows.length){showToast('No changes.','info');return;}
    var saved=0;
    for(var i=0;i<rows.length;i++){
        var $r=$(rows[i]);var n=$r.find('.col-name').val().trim();if(!n)continue;
        var p={classLevelId:parseInt($r.attr('data-id'))||0,name:n,sortOrder:parseInt($r.find('.col-sort').val())||0};
        await $.ajax({url:'/Lookup/SaveClassLevel',type:'POST',contentType:'application/json',data:JSON.stringify(p)});saved++;
    }
    if(saved)showToast(saved+' class level(s) saved.');loadGrid();
});
$('#btnAddRow').click(function(){$('#gridBody').append(blankRow());bindEvents();$('#gridBody tr:last-child .col-name').focus();});
loadGrid();
</script>}
