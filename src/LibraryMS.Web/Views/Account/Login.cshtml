@model LibraryMS.Application.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;   // standalone page — no navbar
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Library Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --lms-primary: #1e40af;
            --lms-primary-dark: #1e3a8a;
        }
        * { box-sizing: border-box; }
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
        }
        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .login-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 25px 50px rgba(0,0,0,.25);
            width: 100%;
            max-width: 420px;
            overflow: hidden;
        }
        .login-header {
            background: linear-gradient(135deg, #1e3a8a, #1e40af);
            padding: 32px 32px 24px;
            text-align: center;
            color: #fff;
        }
        .login-header .brand-icon {
            width: 60px; height: 60px;
            background: rgba(255,255,255,.2);
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 12px;
            border: 1px solid rgba(255,255,255,.3);
        }
        .login-header h4 {
            font-size: 1.2rem;
            font-weight: 700;
            margin: 0 0 4px;
        }
        .login-header p {
            font-size: .82rem;
            opacity: .8;
            margin: 0;
        }
        .login-body { padding: 32px; }
        .form-label {
            font-size: .82rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 4px;
        }
        .form-control {
            border-radius: 8px;
            border: 1px solid #d1d5db;
            font-size: .9rem;
            padding: 10px 14px;
            transition: all .18s;
        }
        .form-control:focus {
            border-color: #1e40af;
            box-shadow: 0 0 0 3px rgba(30,64,175,.12);
        }
        .btn-login {
            background: linear-gradient(135deg, #1e3a8a, #1e40af);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: .9rem;
            font-weight: 600;
            padding: 11px;
            width: 100%;
            cursor: pointer;
            transition: all .2s;
            letter-spacing: .3px;
        }
        .btn-login:hover {
            background: linear-gradient(135deg, #1e3a8a, #1a3a8a);
            box-shadow: 0 4px 12px rgba(30,64,175,.35);
            transform: translateY(-1px);
        }
        .btn-login:active { transform: translateY(0); }
        .input-icon-wrap { position: relative; }
        .input-icon-wrap .bi {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: .95rem;
        }
        .input-icon-wrap .form-control { padding-left: 36px; }
        .login-footer {
            background: #f9fafb;
            border-top: 1px solid #e5e7eb;
            padding: 14px 32px;
            text-align: center;
            font-size: .75rem;
            color: #9ca3af;
        }
        .alert-danger {
            border-radius: 8px;
            font-size: .84rem;
            padding: 10px 14px;
        }
        .live-clock {
            font-size: .75rem;
            opacity: .7;
            margin-top: 6px;
        }
    </style>
</head>
<body>

<div class="login-wrapper">
    <div class="login-card">

        <!-- Header -->
        <div class="login-header">
            <div class="brand-icon">
                <i class="bi bi-journal-bookmark-fill"></i>
            </div>
            <h4>Library Management System</h4>
            <p>Sign in to your account</p>
            <div class="live-clock" id="loginClock"></div>
        </div>

        <!-- Body -->
        <div class="login-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label class="form-label" for="Email">
                        <i class="bi bi-envelope me-1"></i>Email Address
                    </label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" type="email" class="form-control"
                               id="Email" placeholder="admin@library.com"
                               autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="Password">
                        <i class="bi bi-lock me-1"></i>Password
                    </label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" type="password" class="form-control"
                               id="Password" placeholder="Enter password"
                               autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 d-flex align-items-center justify-content-between">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" style="font-size:.82rem;color:#6b7280">
                            Remember me
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>

            </form>
        </div>

        <!-- Footer -->
        <div class="login-footer">
            Library Management System &copy; @DateTime.Now.Year
        </div>

    </div>
</div>

<script>
    // Live clock on login page
    function updateLoginClock() {
        var now  = new Date();
        var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
        var mons = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var d = now.getDate().toString().padStart(2,'0');
        var h = now.getHours() % 12 || 12;
        var m = now.getMinutes().toString().padStart(2,'0');
        var s = now.getSeconds().toString().padStart(2,'0');
        var ap = now.getHours() >= 12 ? 'PM' : 'AM';
        document.getElementById('loginClock').textContent =
            days[now.getDay()] + ', ' + d + ' ' + mons[now.getMonth()] + ' ' + now.getFullYear() +
            '  |  ' + h + ':' + m + ':' + s + ' ' + ap;
    }
    updateLoginClock();
    setInterval(updateLoginClock, 1000);
</script>

</body>
</html>
