<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Library MS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<!-- ══ Navbar ════════════════════════════════════════════════════════ -->
<nav class="navbar navbar-expand-lg lms-navbar">
    <div class="container-fluid">

        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <div class="brand-icon"><i class="bi bi-journal-bookmark-fill"></i></div>
            <div>
                <div style="font-size:.95rem;line-height:1.1">Library MS</div>
                <div style="font-size:.62rem;opacity:.7;font-weight:400;letter-spacing:.05em">Management System</div>
            </div>
        </a>

        <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <i class="bi bi-list fs-5"></i>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto ms-3 gap-1">

                <!-- File -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-folder2-open me-1"></i>File
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i>Home / Dashboard</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#">
                            <i class="bi bi-box-arrow-right"></i>Exit</a></li>
                    </ul>
                </li>

                <!-- Admin -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-gear me-1"></i>Admin
                    </a>
                    <ul class="dropdown-menu" style="min-width:230px">
                        <li><span class="dropdown-header">Book Catalog</span></li>
                        <li><a class="dropdown-item" asp-controller="Books" asp-action="Create">
                            <i class="bi bi-plus-circle"></i>New Book</a></li>
                        <li><a class="dropdown-item" asp-controller="Books" asp-action="Index">
                            <i class="bi bi-book"></i>Manage Books</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><span class="dropdown-header">Purchases</span></li>
                        <li><a class="dropdown-item" asp-controller="Purchases" asp-action="Create">
                            <i class="bi bi-cart-plus"></i>New Purchase Order/Invoice</a></li>
                        <li><a class="dropdown-item" asp-controller="Purchases" asp-action="Index">
                            <i class="bi bi-clock-history"></i>Purchase History</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><span class="dropdown-header">Members</span></li>
                        <li><a class="dropdown-item" asp-controller="Students" asp-action="Index">
                            <i class="bi bi-people"></i>Manage Students</a></li>
                        <li><a class="dropdown-item" asp-controller="Employees" asp-action="Index">
                            <i class="bi bi-person-badge"></i>Manage Employees</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><span class="dropdown-header">Master Data</span></li>
                        <li><a class="dropdown-item" asp-controller="Authors" asp-action="Index">
                            <i class="bi bi-person-lines-fill"></i>Manage Authors</a></li>
                        <li><a class="dropdown-item" asp-controller="Publishers" asp-action="Index">
                            <i class="bi bi-building"></i>Manage Publishers</a></li>
                        <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">
                            <i class="bi bi-tags"></i>Manage Categories</a></li>
                        <li><a class="dropdown-item" asp-controller="BookTypes" asp-action="Index">
                            <i class="bi bi-bookmark-star"></i>Manage Types</a></li>
                        <li><a class="dropdown-item" asp-controller="Vendors" asp-action="Index">
                            <i class="bi bi-shop"></i>Manage Vendors</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><span class="dropdown-header">Academic Lookups</span></li>
                        <li><a class="dropdown-item" asp-controller="Lookup" asp-action="Sessions">
                            <i class="bi bi-calendar-range"></i>Sessions</a></li>
                        <li><a class="dropdown-item" asp-controller="Lookup" asp-action="ClassLevels">
                            <i class="bi bi-mortarboard"></i>Class Levels</a></li>
                        <li><a class="dropdown-item" asp-controller="Lookup" asp-action="Sections">
                            <i class="bi bi-collection"></i>Sections</a></li>
                    </ul>
                </li>

                <!-- Reports -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-bar-chart-line me-1"></i>Reports
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="BooksInventory">
                            <i class="bi bi-database"></i>Books Inventory</a></li>
                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="IssuedBooks">
                            <i class="bi bi-journal-check"></i>Issued Books</a></li>
                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="Overdue">
                            <i class="bi bi-exclamation-triangle"></i>Overdue Books</a></li>
                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="Purchases">
                            <i class="bi bi-receipt"></i>Purchases</a></li>
                    </ul>
                </li>

                <!-- Windows -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-window-stack me-1"></i>Windows
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="IssueReturn" asp-action="Index">
                            <i class="bi bi-arrow-left-right"></i>Issue / Return Books</a></li>
                        <li><a class="dropdown-item" asp-controller="IssuedBooks" asp-action="Index">
                            <i class="bi bi-journals"></i>Manage Issued Books</a></li>
                        <li><a class="dropdown-item" asp-controller="OverdueBooks" asp-action="Index">
                            <i class="bi bi-alarm"></i>Overdue Books</a></li>
                    </ul>
                </li>

            </ul>

            <!-- Right side -->
            <div class="d-flex align-items-center gap-2">
                <div class="nav-date-badge">
                    <i class="bi bi-calendar3"></i>
                    <span id="navLiveDate">@DateTime.Today.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>
    </div>
</nav>

<!-- ══ Page Body ══════════════════════════════════════════════════════ -->
<main class="lms-main">
    <!-- Toast container -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index:9999;margin-top:66px" id="toastContainer"></div>

    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<!-- Live clock — updates every second sitewide -->
<script>
    var monthNames = ['January','February','March','April','May','June',
                      'July','August','September','October','November','December'];
    var dayNames   = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    var monthShort = ['Jan','Feb','Mar','Apr','May','Jun',
                      'Jul','Aug','Sep','Oct','Nov','Dec'];

    function pad(n) { return n < 10 ? '0' + n : n; }

    function updateClock() {
        var now  = new Date();
        var day  = dayNames[now.getDay()];
        var d    = pad(now.getDate());
        var mon  = monthNames[now.getMonth()];
        var monS = monthShort[now.getMonth()];
        var yr   = now.getFullYear();
        var h    = pad(now.getHours());
        var m    = pad(now.getMinutes());
        var s    = pad(now.getSeconds());
        var ampm = now.getHours() >= 12 ? 'PM' : 'AM';
        var h12  = now.getHours() % 12 || 12;

        // Welcome banner — full date
        var $full = $('#liveDateFull');
        if ($full.length) $full.text(day + ', ' + d + ' ' + mon + ' ' + yr);

        // Welcome banner — live time
        var $time = $('#liveTime');
        if ($time.length) $time.text(pad(h12) + ':' + m + ':' + s + ' ' + ampm);

        // Navbar badge — short date
        var $nav = $('#navLiveDate');
        if ($nav.length) $nav.text(d + ' ' + monS + ' ' + yr);
    }

    updateClock();
    setInterval(updateClock, 1000);
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
