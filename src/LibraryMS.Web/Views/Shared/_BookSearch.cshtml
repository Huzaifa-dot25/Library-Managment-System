@* Reusable Book Search widget.
   Usage: @await Html.PartialAsync("_BookSearch", "widgetId")
   Pass a unique widgetId string to avoid ID clashes when used multiple times. *@
@model string
@{
    var wid = string.IsNullOrEmpty(Model) ? "bs" : Model;
}

<div class="lms-widget" id="bookSearchWidget_@wid">
    <div class="lms-widget-header">
        <i class="bi bi-search"></i> Book Search
    </div>
    <div class="lms-widget-body">
        <div class="mb-2">
            <label class="form-label">Search Criteria</label>
            <select class="form-select form-select-sm" id="bsCriteria_@wid">
                <option value="">-- select --</option>
                <option value="isbn">By ISBN No</option>
                <option value="title">By Book Title</option>
                <option value="price">By Price</option>
                <option value="category">By Category</option>
                <option value="author">By Author</option>
            </select>
        </div>
        <div class="mb-2">
            <label class="form-label">Keywords</label>
            <input type="text" class="form-control form-control-sm" id="bsKeyword_@wid" placeholder="Enter keyword..." />
        </div>
        <button class="btn btn-sm w-100 btn-lms-primary" id="bsBtn_@wid">
            <i class="bi bi-search"></i> Search
        </button>

        <div class="mt-2" id="bsResultsWrap_@wid">
            <div class="text-muted-sm text-center py-1" id="bsMsg_@wid" style="display:none"></div>
            <div style="max-height:220px;overflow-y:auto">
                <table class="table table-sm table-bordered mb-0" id="bsTable_@wid" style="font-size:.73rem;display:none">
                    <thead class="table-primary">
                        <tr>
                            <th>ISBN</th>
                            <th>Book Title</th>
                            <th>Author</th>
                            <th class="text-center">Total Qty</th>
                            <th class="text-center">Qty in Lib</th>
                        </tr>
                    </thead>
                    <tbody id="bsBody_@wid"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    var wid = '@wid';

    function doSearch() {
        var criteria = $('#bsCriteria_' + wid).val();
        var keyword  = $('#bsKeyword_' + wid).val().trim();
        if (!keyword) { showToast('Please enter a keyword.', 'info'); return; }

        $('#bsMsg_' + wid).text('Searching...').show();
        $('#bsTable_' + wid).hide();

        $.get('/Books/Search', { criteria: criteria, keyword: keyword }, function(res) {
            if (!res || !res.length) {
                $('#bsMsg_' + wid).text('No books found.').show();
                $('#bsTable_' + wid).hide();
                return;
            }
            $('#bsMsg_' + wid).hide();
            var $body = $('#bsBody_' + wid).empty();
            res.forEach(function(b) {
                $body.append(
                    '<tr>' +
                    '<td>' + (b.isbn||'') + '</td>' +
                    '<td>' + b.title + '</td>' +
                    '<td>' + (b.authors||'') + '</td>' +
                    '<td class="text-center">' + b.totalQuantity + '</td>' +
                    '<td class="text-center ' + (b.remainingQuantity===0?'text-danger fw-bold':'') + '">' + b.remainingQuantity + '</td>' +
                    '</tr>'
                );
            });
            $('#bsTable_' + wid).show();
        });
    }

    $(document).on('click', '#bsBtn_' + wid, doSearch);
    $(document).on('keypress', '#bsKeyword_' + wid, function(e) {
        if (e.which === 13) doSearch();
    });
})();
</script>
