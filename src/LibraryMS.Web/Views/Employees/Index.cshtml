@{
    ViewData["Title"] = "Manage Employees";
}

@if (TempData["Success"] != null)
{
    <div class="lms-success-banner"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="lms-page-header">
    <div>
        <h4><i class="bi bi-person-badge-fill"></i> Manage Employees</h4>
        <div class="header-subtitle">Search, add and manage employee library members.</div>
    </div>
    <a asp-action="Create" class="btn-lms-primary">
        <i class="bi bi-plus-lg"></i> Add Employee
    </a>
</div>

<!-- Filter Bar -->
<div class="lms-card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Search (Name / Code / Department)</label>
            <input type="text" class="form-control form-control-sm" id="fKeyword" placeholder="Type to search..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select class="form-select form-select-sm" id="fStatus">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
                <option value="Both">Both</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary btn-sm flex-grow-1" id="btnSearch">
                <i class="bi bi-search me-1"></i>Search
            </button>
            <button class="btn btn-outline-secondary btn-sm" id="btnReset" title="Clear">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>
    </div>
</div>

<!-- Grid -->
<div class="lms-grid-wrapper">
    <div class="lms-grid-scroll">
        <table class="lms-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th style="width:15%">Employee Code</th>
                    <th style="width:20%">Department</th>
                    <th style="width:10%;text-align:center">Status</th>
                    <th style="width:90px;text-align:center">Actions</th>
                </tr>
            </thead>
            <tbody id="gridBody">
                <tr><td colspan="5" class="text-center py-4 text-muted">
                    <i class="bi bi-search me-2"></i>Loading...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="lms-action-bar">
        <span class="text-muted-sm" id="resultCount">0 employees</span>
    </div>
</div>

@section Scripts {
<script>
    function esc(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function doSearch() {
        var keyword  = $('#fKeyword').val().trim();
        var status   = $('#fStatus').val();
        $('#gridBody').html('<tr><td colspan="5" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Searching...</td></tr>');
        $.get('/Employees/Search', { searchTerm: keyword || null, activeStatus: status }, function(res) {
            if (!res.length) {
                $('#gridBody').html('<tr><td colspan="5" class="text-center py-4 text-muted"><i class="bi bi-inbox me-2"></i>No employees found.</td></tr>');
                $('#resultCount').text('0 employees');
                return;
            }
            var html = res.map(function(e) {
                var badge = e.isActive
                    ? '<span class="lms-badge lms-badge-active">Active</span>'
                    : '<span class="lms-badge lms-badge-inactive">Inactive</span>';
                return '<tr>' +
                    '<td><strong>' + esc(e.name) + '</strong></td>' +
                    '<td class="text-muted-sm">' + esc(e.employeeCode||'') + '</td>' +
                    '<td class="text-muted-sm">' + esc(e.department||'') + '</td>' +
                    '<td class="text-center">' + badge + '</td>' +
                    '<td class="text-center">' +
                        '<a href="/Employees/Edit/' + e.employeeId + '" class="btn btn-sm btn-outline-primary me-1" title="Edit"><i class="bi bi-pencil"></i></a>' +
                        '<button class="btn btn-sm btn-outline-danger btn-del" data-id="' + e.employeeId + '" title="Delete"><i class="bi bi-trash3"></i></button>' +
                    '</td></tr>';
            }).join('');
            $('#gridBody').html(html);
            $('#resultCount').text(res.length + ' employee(s)');
        });
    }

    $('#btnSearch').click(doSearch);
    $('#fKeyword').on('keypress', function(e) { if (e.which === 13) doSearch(); });
    $('#btnReset').click(function() { $('#fKeyword').val(''); $('#fStatus').val('Active'); doSearch(); });

    $(document).on('click', '.btn-del', function() {
        var id = parseInt($(this).data('id'));
        if (!confirmDelete('Delete this employee?')) return;
        $.post('/Employees/Delete', JSON.stringify(id), function(res) {
            if (res.success) { showToast('Employee deleted.'); doSearch(); }
            else showToast(res.message || 'Could not delete.', 'error');
        }, 'json');
    });

    doSearch();
</script>
}
