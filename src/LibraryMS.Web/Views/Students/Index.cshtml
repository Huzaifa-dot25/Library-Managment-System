@model LibraryMS.Application.ViewModels.StudentViewModel
@{
    ViewData["Title"] = "Manage Students";
}

@if (TempData["Success"] != null)
{
    <div class="lms-success-banner"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="lms-page-header">
    <div>
        <h4><i class="bi bi-people-fill"></i> Manage Students</h4>
        <div class="header-subtitle">Search, add and manage student members.</div>
    </div>
    <a asp-action="Create" class="btn-lms-primary">
        <i class="bi bi-plus-lg"></i> Add Student
    </a>
</div>

<!-- Filter Bar -->
<div class="lms-card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Session</label>
            <select class="form-select form-select-sm" id="fSession">
                <option value="">All Sessions</option>
                @foreach (var s in Model.Sessions)
                {
                    <option value="@s.SessionId">@s.SessionName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Class</label>
            <select class="form-select form-select-sm" id="fClass">
                <option value="">All Classes</option>
                @foreach (var c in Model.ClassLevels)
                {
                    <option value="@c.ClassLevelId">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Section</label>
            <select class="form-select form-select-sm" id="fSection">
                <option value="">All Sections</option>
                @foreach (var s in Model.Sections)
                {
                    <option value="@s.SectionId">@s.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Status</label>
            <select class="form-select form-select-sm" id="fStatus">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
                <option value="Both">Both</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Search By</label>
            <select class="form-select form-select-sm" id="fSearchBy">
                <option value="Name">By Name</option>
                <option value="RegistrationNo">By Registration No</option>
                <option value="RollNo">By Roll No</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Keyword</label>
            <input type="text" class="form-control form-control-sm" id="fKeyword" placeholder="Search..." />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary btn-sm flex-grow-1" id="btnSearch">
                <i class="bi bi-search me-1"></i>Search
            </button>
            <button class="btn btn-outline-secondary btn-sm" id="btnReset" title="Clear">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>
    </div>
</div>

<!-- Grid -->
<div class="lms-grid-wrapper">
    <div class="lms-grid-scroll">
        <table class="lms-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Registration No</th>
                    <th>Roll No</th>
                    <th>Session</th>
                    <th>Class</th>
                    <th>Section</th>
                    <th style="text-align:center">Status</th>
                    <th style="width:90px;text-align:center">Actions</th>
                </tr>
            </thead>
            <tbody id="gridBody">
                <tr><td colspan="8" class="text-center py-4 text-muted">
                    <i class="bi bi-search me-2"></i>Use filters above and click Search.</td></tr>
            </tbody>
        </table>
    </div>
    <div class="lms-action-bar">
        <span class="text-muted-sm" id="resultCount">0 students</span>
    </div>
</div>

@section Scripts {
<script>
    // Cascade: class → section
    $('#fClass').on('change', function() {
        var cid = $(this).val();
        var $sec = $('#fSection').html('<option value="">All Sections</option>');
        if (!cid) return;
        $.get('/Students/GetSections', { classLevelId: cid }, function(data) {
            data.forEach(function(s) {
                $sec.append('<option value="' + s.sectionId + '">' + s.name + '</option>');
            });
        });
    });

    function esc(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function doSearch() {
        var payload = {
            memberType:   'Student',
            sessionId:    parseInt($('#fSession').val()) || null,
            classLevelId: parseInt($('#fClass').val())   || null,
            sectionId:    parseInt($('#fSection').val()) || null,
            activeStatus: $('#fStatus').val(),
            searchBy:     $('#fSearchBy').val(),
            searchTerm:   $('#fKeyword').val().trim() || null
        };
        $('#gridBody').html('<tr><td colspan="8" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Searching...</td></tr>');
        $.ajax({
            url: '/Students/Search', type: 'POST', contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function(res) {
                if (!res.length) {
                    $('#gridBody').html('<tr><td colspan="8" class="text-center py-4 text-muted"><i class="bi bi-inbox me-2"></i>No students found.</td></tr>');
                    $('#resultCount').text('0 students');
                    return;
                }
                var html = res.map(function(s) {
                    var badge = s.isActive
                        ? '<span class="lms-badge lms-badge-active">Active</span>'
                        : '<span class="lms-badge lms-badge-inactive">Inactive</span>';
                    return '<tr>' +
                        '<td><strong>' + esc(s.name) + '</strong></td>' +
                        '<td class="text-muted-sm">' + esc(s.registrationNo||'') + '</td>' +
                        '<td class="text-muted-sm">' + esc(s.rollNo||'') + '</td>' +
                        '<td class="text-muted-sm">' + esc(s.sessionName||'') + '</td>' +
                        '<td class="text-muted-sm">' + esc(s.classLevelName||'') + '</td>' +
                        '<td class="text-muted-sm">' + esc(s.sectionName||'') + '</td>' +
                        '<td class="text-center">' + badge + '</td>' +
                        '<td class="text-center">' +
                            '<a href="/Students/Edit/' + s.studentId + '" class="btn btn-sm btn-outline-primary me-1" title="Edit"><i class="bi bi-pencil"></i></a>' +
                            '<button class="btn btn-sm btn-outline-danger btn-del" data-id="' + s.studentId + '" title="Delete"><i class="bi bi-trash3"></i></button>' +
                        '</td></tr>';
                }).join('');
                $('#gridBody').html(html);
                $('#resultCount').text(res.length + ' student(s)');
            }
        });
    }

    $('#btnSearch').click(doSearch);
    $('#fKeyword').on('keypress', function(e) { if (e.which === 13) doSearch(); });
    $('#btnReset').click(function() {
        $('#fSession,#fClass,#fSection,#fStatus').val('');
        $('#fStatus').val('Active'); $('#fSearchBy').val('Name'); $('#fKeyword').val('');
        doSearch();
    });

    $(document).on('click', '.btn-del', function() {
        var id = parseInt($(this).data('id'));
        if (!confirmDelete('Delete this student?')) return;
        $.post('/Students/Delete', JSON.stringify(id), function(res) {
            if (res.success) { showToast('Student deleted.'); doSearch(); }
            else showToast(res.message || 'Could not delete.', 'error');
        }, 'json');
    });

    // Initial load
    doSearch();
</script>
}
