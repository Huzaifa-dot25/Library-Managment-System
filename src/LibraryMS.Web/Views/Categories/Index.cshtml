@{
    ViewData["Title"] = "Manage Categories";
}

<div class="lms-page-header">
    <div>
        <h4><i class="bi bi-tags-fill"></i> Manage Categories</h4>
        <div class="header-subtitle">Add, edit or remove book categories.</div>
    </div>
    <button class="btn-lms-outline" id="btnAddRow">
        <i class="bi bi-plus-lg"></i> Add Row
    </button>
</div>

<div class="lms-grid-wrapper">
    <div class="lms-grid-scroll">
        <table class="lms-table">
            <thead>
                <tr>
                    <th style="width:95%">Category Name</th>
                    <th style="width:5%;text-align:center">Delete</th>
                </tr>
            </thead>
            <tbody id="gridBody">
                <tr><td colspan="2" class="text-center py-4 text-muted">
                    <i class="bi bi-hourglass-split me-2"></i>Loading...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="lms-action-bar">
        <button class="btn-lms-success" id="btnSave">
            <i class="bi bi-save2"></i> Save
        </button>
        <button class="btn-lms-secondary" onclick="window.location='/'">
            <i class="bi bi-x-lg"></i> Close
        </button>
        <span class="ms-auto text-muted-sm" id="statusMsg"></span>
    </div>
</div>

@section Scripts {
<script>
    function esc(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    function renderRow(c) {
        return '<tr data-id="' + c.categoryId + '" data-dirty="false">' +
            '<td><input type="text" class="grid-input col-name" value="' + esc(c.name) + '" placeholder="Category name..." /></td>' +
            '<td class="text-center"><button class="btn-grid-delete" data-id="' + c.categoryId + '" title="Delete"><i class="bi bi-trash3"></i></button></td>' +
            '</tr>';
    }

    function blankRow() { return renderRow({ categoryId:0, name:'' }); }

    function loadGrid() {
        $.get('/Categories/GetAll', function(data) {
            $('#gridBody').html(data.map(renderRow).join('') + blankRow());
            bindEvents();
        });
    }

    function bindEvents() {
        $('#gridBody').off('input').on('input', 'input', function() {
            var $row = $(this).closest('tr').attr('data-dirty','true').addClass('row-dirty');
            if ($row.is(':last-child') && $row.attr('data-id')==='0') {
                $('#gridBody').append(blankRow());
                bindEvents();
            }
        });
        $('#gridBody').off('click','.btn-grid-delete').on('click','.btn-grid-delete', function() {
            var id = parseInt($(this).data('id'));
            var $row = $(this).closest('tr');
            if (id === 0) { $row.remove(); return; }
            if (!confirmDelete('Delete this category?')) return;
            $.post('/Categories/Delete', JSON.stringify(id), function(res) {
                if (res.success) { $row.fadeOut(200, function(){ $(this).remove(); }); showToast('Category deleted.'); }
                else showToast(res.message, 'error');
            }, 'json');
        });
    }

    $('#btnSave').click(function() {
        var payload = [];
        $('#gridBody tr[data-dirty="true"]').each(function() {
            var name = $(this).find('.col-name').val().trim();
            if (!name) return;
            payload.push({ categoryId: parseInt($(this).attr('data-id'))||0, name: name });
        });
        if (!payload.length) { showToast('No changes to save.', 'info'); return; }
        $.ajax({ url:'/Categories/SaveAll', type:'POST', contentType:'application/json',
            data: JSON.stringify(payload),
            success: function(res) {
                if (res.success) { showToast('Categories saved.'); loadGrid(); }
                else showToast(res.message,'error');
            }
        });
    });

    $('#btnAddRow').click(function() {
        $('#gridBody').append(blankRow());
        bindEvents();
        $('#gridBody tr:last-child .col-name').focus();
    });

    loadGrid();
</script>
}
